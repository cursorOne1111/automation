# Android 默认启动系统设置，不需要 APK
MOBILE_PLATFORM=android
APPIUM_URL=http://127.0.0.1:4723
DEVICE_NAME=Android Emulator
# DEVICE_UDID=emulator-5554
# PLATFORM_VERSION=15
# APP_PATH=/absolute/path/your.apk
# APP_PACKAGE=com.android.settings
# APP_ACTIVITY=.Settings
# iOS: MOBILE_PLATFORM=ios DEVICE_UDID=模拟器UDID，默认 com.apple.Preferences
# APP_BUNDLE_ID=com.apple.Preferences
# CAPABILITIES_FILE=config/android.json
# CAPTURES_PAGE_SOURCE=1  # XML 可能包含业务数据，按需打开
# 以下仅用于业务登录示例；定位值需在 Appium Inspector 中核实
# LOGIN_USERNAME_ID=login-username
# LOGIN_PASSWORD_ID=login-password
# LOGIN_SUBMIT_ID=login-submit
# LOGIN_SUCCESS_ID=home-screen
# TEST_USERNAME=qa-user
# TEST_PASSWORD=测试环境密码
